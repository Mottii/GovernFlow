POSTGRES_PASSWORD=replace_for_local_use
DATABASE_URL=postgresql+asyncpg://governflow_app:replace_with_generated_url_safe_secret@localhost:55433/gateway
MASTER_ENCRYPTION_KEY=base64_of_32_random_bytes
DECISION_SIGNING_KEY=base64_of_32_random_bytes
ADMIN_TOKEN=replace_with_random_token
UPSTREAM_TIMEOUT_S=120
DEFAULT_FAIL_MODE=closed
DEFAULT_MAX_OUTPUT_TOKENS=4096
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_ADMIN_URL=http://localhost:8001
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=
OPENAI_PROJECT_ID=
ANTHROPIC_WORKSPACE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
APPROVAL_EMAIL_TO=
APPROVAL_WEBHOOK_URL=

ADMIN_API_URL=http://localhost:8001
DASHBOARD_PUBLIC_URL=http://localhost:3000
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=
DRIFT_COST_TOLERANCE_MICRO=1
DRIFT_TOKEN_TOLERANCE=0
REQUIRE_PROVIDER_MAPPING=false

# Separate runtime login; use a URL-safe generated secret (at least 20 characters).
APP_DATABASE_PASSWORD=replace_with_generated_url_safe_secret

# Accounting recovery (hosted deployments require S3 and always fail closed).
DEPLOYMENT_MODE=self_hosted
RECOVERY_BACKEND=sqlite
RECOVERY_S3_BUCKET=
RECOVERY_S3_PREFIX=governflow-recovery
RECOVERY_S3_ENDPOINT=
AWS_DEFAULT_REGION=us-east-1
ALLOW_FAIL_OPEN=false
SELF_HOSTED_SINGLE_NODE=false
MAX_OUTPUT_TOKENS=32768
MAX_REQUEST_BYTES=2097152
GATEWAY_MAX_INFLIGHT=128
WORKFLOW_MAX_INFLIGHT=32
CALL_DEADLINE_SECONDS=300
CALL_LEASE_SECONDS=60
CALL_RENEW_SECONDS=15
DB_POOL_SIZE=10

# Optional deployment key rings: JSON maps of four-digit hex IDs to base64 32-byte keys.
# Existing single-key values are retained as key ID 0000.
ENCRYPTION_KEYS=
ACTIVE_ENCRYPTION_KEY_ID=0000
SIGNING_KEYS=
ACTIVE_SIGNING_KEY_ID=0000
